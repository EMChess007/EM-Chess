#!/bin/sh
# The pre-push gate: workflow files, tsc and the fast vitest suites (scripts/pre-push.mjs). Installed by `npm install` (the "prepare" script points core.hooksPath at this folder).
# A WIP push may skip it only on purpose:  SKIP_PREPUSH=wip git push   (the skip is printed and logged in .git/pre-push-skips.log). `git push --no-verify` skips every hook.
node scripts/pre-push.mjs || { echo "pre-push: push blocked." >&2; exit 1; }
